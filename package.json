{
    "name": "amanuensis",
    "version": "0.1.0",
    "description": "Audio transcription and annotation desktop app",
    "main": "./out/main/index.js",
    "author": "",
    "homepage": ".",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
        "build:electron": "electron-builder",
        "build:sidecar": "cd sidecar && poetry run pyinstaller amanuensis-sidecar.spec --distpath ../dist-sidecar --workpath ../build-sidecar --clean",
        "build:all": "npm run build:sidecar && npm run build && npm run build:electron"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.1",
        "@electron-toolkit/utils": "^3.0.0",
        "@meersagor/wavesurfer-vue": "^2.0.2",
        "@vueuse/core": "^11.3.0",
        "pinia": "^2.2.6",
        "vue": "^3.5.13",
        "wavesurfer.js": "^7.12.6"
    },
    "build": {
        "appId": "com.amanuensis.app",
        "productName": "Amanuensis",
        "icon": "build/icon.png",
        "directories": {
            "output": "release"
        },
        "extraResources": [
            {
                "from": "dist-sidecar/amanuensis-sidecar",
                "to": "sidecar",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSMicrophoneUsageDescription": "Amanuensis needs microphone access to record audio for transcription."
            }
        },
        "win": {
            "target": "nsis"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^2.0.0",
        "@electron-toolkit/eslint-config-ts": "^2.0.0",
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@types/node": "^22.10.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "typescript": "^5.7.2",
        "vite": "^5.4.0",
        "vue-tsc": "^2.2.0"
    }
}
